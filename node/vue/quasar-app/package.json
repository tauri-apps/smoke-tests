{
  "name": "quasar-app",
  "version": "0.0.1",
  "description": "A Quasar Framework app",
  "productName": "Quasar App",
  "author": "Daniel Thompson-Yvetot <denjell@sfosc.org>",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.vue src",
    "test": "echo \"No test specified\" && exit 0",
    "build": "quasar build && node ./scripts/compile-node.js",
    "tauri:source": "node ../../../../tooling/cli.js/bin/tauri",
    "tauri:dev": "yarn tauri:source dev",
    "tauri:build": "yarn tauri:source build"
  },
  "dependencies": {
    "@quasar/extras": "2.0.2",
    "@tauri-apps/api": "2.11.1",
    "core-js": "3.49.0",
    "quasar": "2.22.0"
  },
  "devDependencies": {
    "@quasar/app": "3.3.3",
    "@tauri-apps/tauri-webpack": "0.2.0",
    "@vue/eslint-config-standard": "9.0.1",
    "@babel/eslint-parser": "8.0.1",
    "eslint": "10.7.0",
    "eslint-loader": "4.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.2.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-standard": "5.0.0",
    "eslint-plugin-vue": "10.10.0",
    "execa": "10.0.0",
    "pkg": "5.8.1",
    "workbox-webpack-plugin": "7.4.1"
  },
  "engines": {
    "node": ">= 8.9.0",
    "npm": ">= 5.6.0",
    "yarn": ">= 1.6.0"
  },
  "browserslist": [
    "last 1 version, not dead, ie >= 11"
  ]
}
